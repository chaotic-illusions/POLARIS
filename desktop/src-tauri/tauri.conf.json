{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "POLARIS",
  "version": "1.0.0",
  "identifier": "org.crymson.lcars-builder",
  "build": {
    "frontendDist": "../web",
    "beforeDevCommand": "node stage.mjs",
    "beforeBuildCommand": "node stage.mjs"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "create": false,
        "title": "POLARIS",
        "url": "builder/index.html",
        "width": 1700,
        "height": 1000,
        "minWidth": 1000,
        "minHeight": 650,
        "maximized": true,
        "backgroundColor": "#000000",
        "additionalBrowserArgs": "--disable-features=msWebOOUI,msPdfOOUI,msSmartScreenProtection --autoplay-policy=no-user-gesture-required"
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline' https://fonts.googleapis.com",
        "font-src": "'self' data: https://fonts.gstatic.com",
        "img-src": "'self' data: blob: https: http:",
        "media-src": "'self' data: blob:",
        "connect-src": "'self' blob: ipc: http://ipc.localhost",
        "frame-src": "'self'",
        "object-src": "'none'",
        "base-uri": "'none'",
        "form-action": "'none'"
      },
      "dangerousDisableAssetCspModification": ["style-src"]
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "chaotic-illusions",
    "shortDescription": "Lay out LCARS pages and sites",
    "fileAssociations": [
      {
        "ext": ["lcars"],
        "name": "LCARS project",
        "description": "POLARIS project",
        "role": "Editor",
        "mimeType": "application/x-lcars-project"
      }
    ],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"]
  }
}
